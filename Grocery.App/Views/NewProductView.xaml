<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grocery.App.Views.NewProductView"
             Title="Nieuw Product Toevoegen">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Productnaam:" />
        <Entry Text="{Binding Name}" Placeholder="Naam" />

        <Label Text="Prijs:" />
        <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="Prijs" />

        <Label Text="Voorraad:" />
        <Entry Text="{Binding Stock}" Keyboard="Numeric" Placeholder="Voorraad" />

        <Button Text="Product toevoegen"
                Command="{Binding AddProductCommand}" />
    </VerticalStackLayout>
</ContentPage>